{
  "schemaVersion": 1,
  "id": "olib",
  "version": "${version}",
  "name": "O Lib",
  "description": "The versatile core engine behind your favorite mods.",
  "authors": [
    "Tarek Sharabaty",
    "Oidioom"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/olib/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.oidioomstudio.olib.OLibMod"
