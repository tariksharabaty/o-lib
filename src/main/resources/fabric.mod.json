    "client": [
      "com.oidioomstudio.olib.client.OLibClientMod"
    ],
    "modmenu": [
      "com.oidioomstudio.olib.client.OLibModMenuIntegration"
    ]
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.instagram.lordotarik": "https://www.instagram.com/lordotarik",
        "modmenu.instagram.oidioom": "https://www.instagram.com/oidioom"
      }
    }
  },
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "mixins": [
    "olib.mixins.json"
  ]
